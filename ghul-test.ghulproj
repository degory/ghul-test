<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <Title>ghūl test</Title>
    <PackageDescription>ghūl compiler snapshot test runner</PackageDescription>
    <PackageTags>ghul;ghūl;compiler;test;test-automation</PackageTags>
    <PackageProjectUrl>https://ghul.dev</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/degory/ghul-test</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <PackageIcon>ghul-logo-icon.png</PackageIcon>
    <PackageIconUrl>ghul-logo-icon.png</PackageIconUrl>

    <PackageId>ghul.test</PackageId>
    <Authors>degory</Authors>
    <Company>ghul.dev</Company>

    <PackageOutputPath>./nupkg</PackageOutputPath>
    <IsTool>true</IsTool>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ghul-test</ToolCommandName>

    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft's own disassembler, used to produce the IL a test's
         il.expected snapshot is compared against. -->
    <PackageReference Include="runtime.linux-x64.Microsoft.NETCore.ILDAsm" />
    <PackageReference Include="runtime.win-x64.Microsoft.NETCore.ILDAsm" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>  
    <None Include="LICENSE*" Pack="true" PackagePath="\" />

    <None Include="./images/ghul-logo-icon.png" Pack="true" PackagePath=""/>

    <GhulSources Include="src/**/*.ghul" />


    <!-- A pipe combinator's function parameter is declared pure, and the
         predicates passed here call into imported .NET members that cannot
         be proven store-free. The warning is advisory, and the build output
         is captured by the integration tests' snapshots, so a warning here
         fails tests that are about the runner's report rather than its
         source. -->
    <GhulOptions Include="--suppress impure-function-argument" />

    <!-- Terminator-free sources; error on CI so stray `;` cannot creep
         back in, warning locally. -->
    <GhulOptions Include="--warn redundant-semicolon" />
    <GhulOptions Include="--warn-as-error redundant-semicolon" Condition="'$(CI)' != ''" />
  </ItemGroup>
</Project>
