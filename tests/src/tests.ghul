namespace Tests is
    use Collections.LIST;
    
    use FluentAssertions.Collections.GenericCollectionAssertions;
    use FluentAssertions.Primitives;
    use FluentAssertions.Numeric;

    use Tester;

    entry() is
        return;
    si

    get_stub_test() -> TEST => new TEST("path", new LIST[string](), "", false);

    // ghūl doesn't have extension methods, so wrap these for easier consumption:
    should[T](iterable: Collections.Iterable[T]) -> GenericCollectionAssertions[T] => new GenericCollectionAssertions[T](iterable);

    should(s: string) -> StringAssertions[StringAssertions] => new StringAssertions(s);

    should(o: object) -> ObjectAssertions[object,ObjectAssertions] => new ObjectAssertions(o);

    should(b: bool) -> BooleanAssertions[BooleanAssertions] is
        let value: bool? = b;

        return new BooleanAssertions(value);
    si
si