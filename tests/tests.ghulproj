<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DebugType>None</DebugType>
    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    
    <ProjectReference Include="../ghul-test.ghulproj" />

    <GhulSources Include="src/**/*.ghul" />


    <!-- Terminator-free sources; error on CI so stray `;` cannot creep
         back in, warning locally. -->
    <GhulOptions Include="--warn redundant-semicolon" />
    <GhulOptions Include="--warn-as-error redundant-semicolon" Condition="'$(CI)' != ''" />
  </ItemGroup>
</Project>
