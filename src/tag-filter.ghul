namespace Tester is
    use Collections.Iterable;
    use Collections.List;
    use Collections.LIST;

    class TAG_FILTER(requested_tags: Iterable[string] init) is
        _requested: List[string];

        is_empty: bool => _requested.count == 0;

        init(..) is
            _requested = LIST[string](requested_tags);
        si

        matches(tags: Iterable[string]) -> bool is
            if is_empty then
                return true;
            fi

            return tags | .any(tag => _requested | .any(r => r =~ tag));
        si

        parse_tags(content: string) -> Iterable[string] static =>
            content.split([' ', '\t', '\n', '\r']) |
                .map(t => t.trim()) |
                .filter(t => t.length > 0);
    si
si
