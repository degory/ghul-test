namespace Tester is
    use IO.File
    use IO.Path
    use IO.Std

    use Collections.LIST

    // Produces the IL text a test's `il.expected` snapshot is compared
    // against, by disassembling the assembly the compiler emitted.
    //
    // The text comes from Microsoft's own ildasm rather than from
    // anything written here: a snapshot is only worth as much as the
    // reader that produces it, and a hand-written metadata decoder would
    // be one more thing able to be wrong in the same way the compiler is.
    class DISASSEMBLER(command: string? init) is
        // Absent when no disassembler could be found, which is not an
        // error until a test actually asks for IL.
        _executable: string?

        // A disassembler named explicitly is checked the way an
        // explicitly named compiler or runtime is, and for the same
        // reason: falling back to discovery would quietly use something
        // other than what was asked for, and accepting the path unchecked
        // would surface a typo as whatever the process launch happens to
        // throw, per test, rather than as one clear message.
        init(..) is
            if command? /\ !string.is_null_or_white_space(command) then
                let trimmed = command.trim()

                if !File.exists(trimmed) then
                    throw System.Exception("disassembler not found: {trimmed}");
                fi

                // Resolved here, because it is checked against this
                // directory and then run from another: each test is
                // launched with its own folder as the working directory,
                // so a relative path would name a different file there,
                // or nothing at all.
                _executable = Path.get_full_path(trimmed);
            else
                _executable = _discover();
            fi

        si

        is_available: bool => _executable?

        executable: string? => _executable

        // Where the packaged native lands. Reached only when nothing was
        // named: an explicit path, whether from the flag or from the
        // environment, is validated rather than quietly replaced by this.
        _discover() -> string? static is
            let beside_tool = _beside_tool()

            if beside_tool? /\ File.exists(beside_tool) then
                _make_executable(beside_tool)

                return beside_tool;
            fi

            return null;
        si

        // A NuGet package carries no Unix permissions, so the native
        // arrives without its execute bit and launching it fails with
        // "Permission denied" - naming the path, which exists, rather
        // than anything about permissions. Only the copy shipped inside
        // the tool is touched: a path someone named is theirs.
        _make_executable(path: string) static is
            if System.Runtime.InteropServices.RuntimeInformation.is_o_s_platform(
                System.Runtime.InteropServices.OSPlatform.windows)
            then
                return;
            fi

            try
                let mode = cast int(File.get_unix_file_mode(path))

                let wanted =
                    mode |
                    cast int(IO.UnixFileMode.USER_EXECUTE) |
                    cast int(IO.UnixFileMode.GROUP_EXECUTE) |
                    cast int(IO.UnixFileMode.OTHER_EXECUTE)

                if mode != wanted then
                    File.set_unix_file_mode(path, cast IO.UnixFileMode(wanted));
                fi
            catch ex: System.Exception
                // An install directory that cannot be written to leaves
                // the launch to fail and report itself.
            yrt
        si

        _beside_tool() -> string? static is
            let assembly = System.Reflection.Assembly.get_executing_assembly()

            let location = assembly.location

            if string.is_null_or_white_space(location) then
                return null;
            fi

            let folder = Path.get_directory_name(Path.get_full_path(location))

            if !folder? then
                return null;
            fi

            return Path.join([folder, "runtimes", _runtime_identifier(), "native", _file_name()]);
        si

        _runtime_identifier() -> string static =>
            if System.Runtime.InteropServices.RuntimeInformation.is_o_s_platform(
                System.Runtime.InteropServices.OSPlatform.windows)
            then
                "win-x64";
            else
                "linux-x64";
            fi

        _file_name() -> string static =>
            if System.Runtime.InteropServices.RuntimeInformation.is_o_s_platform(
                System.Runtime.InteropServices.OSPlatform.windows)
            then
                "ildasm.exe";
            else
                "ildasm";
            fi

        // Options are given with a leading `-`. The `/` spelling the
        // usage text documents is read as a path on Linux, and the run
        // fails with "MULTIPLE INPUT FILES SPECIFIED" rather than with
        // anything naming the option.
        // `item` scopes the dump to one type or member, so a snapshot
        // holds the construct the test is about rather than the whole
        // assembly - which keeps it readable and stops an unrelated
        // change elsewhere in the assembly perturbing it.
        arguments(
            assembly_path: string,
            output_path: string,
            item: string?
        ) -> Collections.List[string] static is
            let result = LIST[string]()

            result.add("-out={output_path}")

            if item? /\ !string.is_null_or_white_space(item) then
                result.add("-item={item.trim()}");
            fi

            result.add(assembly_path)

            return result;
        si

        // Everything ildasm writes that is not a property of the
        // assembly's contents. `Image base` is the sharpest of them: it
        // is where the file happened to be mapped, so it differs on
        // every run of ildasm over one unchanged file, and a snapshot
        // holding it fails at random. The MVID changes whenever anything
        // in the assembly does, and the banner carries the tool's own
        // version.
        is_unstable_line(line: string) -> bool static =>
            line.starts_with("// Image base:") \/
            line.starts_with("// MVID:") \/
            line.contains(".NET IL Disassembler.") \/
            line.contains("THIS IS A PARTIAL DISASSEMBLY")

        // ildasm opens the types and members with this banner. Everything
        // before it describes the assembly as a container rather than
        // what it holds: the extern references and their versions, the
        // module name, and the PE header fields. A snapshot asserting a
        // construct has no business holding any of that - the extern
        // versions in particular move whenever a dependency is bumped,
        // which fails every whole-assembly snapshot at once for a reason
        // none of them is about.
        is_members_section_start(line: string) -> bool static =>
            line.contains("CLASS MEMBERS DECLARATION")

        // The members run to a rule of `=` characters, or to the closing
        // banner where the disassembly carries no rule.
        is_members_section_end(line: string) -> bool static =>
            line.starts_with("// =====") \/
            line.contains("DISASSEMBLY COMPLETE");

    si
si
