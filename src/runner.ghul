namespace Tester is
    use System.Exception;
    use System.Text.StringBuilder;

    use Collections.Iterable;
    use Collections.List;
    use Collections.MutableList;
    use Collections.Map;
    use Collections.MutableMap;
    use Collections.LIST;
    use Collections.MAP;

    use Pair = Collections.KeyValuePair;

    use IO.Std;
    use IO.File;
    use IO.Directory;

    use System.Diagnostics.Process;
    use System.Diagnostics.ProcessStartInfo;

    use System.Text.RegularExpressions.Regex;
    use System.Text.RegularExpressions.RegexOptions;

    class RUNNER is
        _collate_environment: MutableMap[string,string]? static;

        _host_cli: string;
        _target_cli: string;

        _failure: FAILURE?;
        _compiler_under_test: COMPILER_UNDER_TEST;
        _disassembler: DISASSEMBLER;

        _test: TEST;

        init(
            host_cli: string,
            target_cli: string,
            compiler_under_test: COMPILER_UNDER_TEST,
            disassembler: DISASSEMBLER,
            test: TEST
        ) is
            _host_cli = host_cli;
            _target_cli = target_cli;
            _compiler_under_test = compiler_under_test;
            _disassembler = disassembler;
            _test = test;

            if !_collate_environment? then
                _collate_environment = MAP[string,string]();
                _collate_environment.add("LC_COLLATE", "C");                    
            fi
        si

        get_result() -> Result is
            if _failure? then
                return _failure;
            else
                return PASS(_test);
            fi
        si

        get_run() -> () -> Result
            is               
                return () -> Result is
                    let result = run_test();
                    
                    return result;
                si;
            si
        
        run_test() -> Result is
            try
                if Directory.get_files(_test.path, "disabled*")| .count() > 0 then
                    return SKIP(_test);
                fi

                _run_test();

                clean_up();

                mark_if_failed();

                return get_result();
            catch ex: Exception
                return FAILURE(_test, ex.message, ex.stack_trace);
            yrt
        si

        _run_test() is
            if _test.source_files| .count() == 0 then
                add_fail("no source files found");
                return;
            fi

            // Left behind by a previous failing run, and a failing run
            // is exactly what gets repeated. Whether the compiler wrote
            // the IL itself is read from this file existing once it has
            // run, so one surviving from last time would be taken for
            // this run's answer and suppress the disassembly.
            delete_files(["il.out", "il.raw", "il.err"]);

            let build_succeeded = _compiler_under_test.run_compiler(self, _test);

            let exit_after_grep_and_sort mut = false;

            if build_succeeded then
                if _test.is_build_fail_expected then
                    add_fail("unexpected build success: {_test.path}");
                    exit_after_grep_and_sort = true;
                fi
            else
                if !_test.is_build_fail_expected then
                    add_fail("unexpected build failure", "compiler.out");
                    exit_after_grep_and_sort = true;
                fi
            fi

            run_grep("error:", "compiler.out", "err.grep");
            run_grep("warn:", "compiler.out", "warn.grep");

            run_sort("err.grep", "err.sort");
            run_sort("warn.grep", "warn.sort");

            normalize_paths("err.sort");
            normalize_paths("warn.sort");

            if exit_after_grep_and_sort then
                return;
            fi

            run_diff("errors", "err.expected", "err.sort", "err.diff", true);

            run_diff("warnings", "warn.expected", "warn.sort", "warn.diff", true);

            run_diff_il_out(build_succeeded);

            if !build_succeeded then
                return;
            fi

            _compiler_under_test.run_ln_runtime(self);

            if !run_binary() then
                return;
            fi

            normalize_paths("run.out");
            strip_stack_trace_locations("run.out");

            run_diff("test output", "run.expected", "run.out", "run.diff", true);
        si

        // A passing test's artifacts are deleted, so what a green run
        // leaves behind is only the failures. That is the wrong way
        // round for anything that wants to inspect what was built —
        // auditing every emitted assembly, or looking at a test that
        // passes but is suspected of passing for the wrong reason.
        // GHUL_TEST_KEEP_ARTIFACTS leaves them in place.
        clean_up() is
            if System.Environment.get_environment_variable("GHUL_TEST_KEEP_ARTIFACTS")? then
                return;
            fi

            if !_failure? then
                delete_files([
                    "binary.exe",
                    "binary.exe.mdb",
                    "binary.runtimeconfig.json",                 
                    "compiler.out",
                    "sed.out",
                    "warn.grep",
                    "warn.diff",
                    "warn.diff",
                    "err.grep",
                    "err.sort",
                    "err.diff",
                    "out.il",
                    "il.out",
                    "il.raw",
                    "il.err",
                    "il.diff",
                    "run.out",
                    "run.err",
                    "run.diff",
                    "ghul-runtime.dll"
                ]);
            fi            
        si
        
        run_binary() -> bool is
            // this needs to be a path relative to the directory
            // that ghul-test was run from
            let binary_path = _compiler_under_test.get_binary_path(self);

            if !File.exists(binary_path) then
                add_fail("no binary found: {binary_path}");
                return false;
            fi

            let exit_status =
                run(
                    _target_cli,
                    // but this needs to be a path relative to the directory
                    // that the test is in
                    [_compiler_under_test.get_binary_path_relative_to_test_folder(self)],
                    5000,
                    "run.out",
                    "run.err"
                );
            
            if 
                exit_status != 0
            then
                add_fail("binary exited with non-zero status ({exit_status})", "run.err");
                return false;
            fi

            return true;
        si
        
        run_diff_il_out(build_succeeded: bool) is
            let il_out_path = get_path("il.out");

            // A compiler that wrote the IL itself has already answered,
            // and that answer is what its test's snapshot was captured
            // from. Disassembling is for the case where nothing was
            // written: a back end emitting binary directly produces no
            // such file, and there would otherwise be nothing to
            // compare. So a test moves from one to the other by dropping
            // whatever made its compiler write the file.
            if
                !File.exists(il_out_path) /\
                File.exists(get_path("il.expected")) /\
                build_succeeded
            then
                run_disassembler(il_out_path);
            fi

            // A test wanting IL that produced none compares an empty
            // file against its snapshot, so the whole snapshot lands on
            // the expected side of the diff and the test fails. Skipping
            // the comparison instead would report a test that emitted
            // nothing as passing.
            if !File.exists(il_out_path) then
                File.create(il_out_path).close();
            fi

            run_diff("IL output", "il.expected", "il.out", "il.diff", true);
        si

        run_disassembler(il_out_path: string) is
            if !_disassembler.is_available then
                return;
            fi

            if !File.exists(_compiler_under_test.get_binary_path(self)) then
                return;
            fi

            let raw_path = get_path("il.raw");
            let item = _requested_il_item();

            // The disassembler runs with the test folder as its working
            // directory, so both paths it is given are relative to that,
            // while everything checked here is relative to where
            // ghul-test itself was started.
            run(
                _disassembler.executable!,
                DISASSEMBLER.arguments(
                    _compiler_under_test.get_binary_path_relative_to_test_folder(self),
                    "il.raw",
                    item),
                30000,
                null,
                "il.err"
            );

            if !File.exists(raw_path) then
                add_fail("disassembler produced no output", "il.err");

                return;
            fi

            // An item the assembly does not contain is not reported by
            // the disassembler: it writes the assembly-level preamble,
            // says nothing about what it could not find, and exits zero.
            // Captured as a snapshot that is a test asserting nothing
            // about the construct it names, and passing for good.
            if item? /\ !_contains_item(raw_path, item) then
                add_fail("il.item names '{item}', which the emitted assembly does not contain");

                File.delete(raw_path);

                return;
            fi

            _write_stable_il(raw_path, il_out_path);

            File.delete(raw_path);

            normalize_paths("il.out");
        si

        // Scoping to something absent is answered with silence and a
        // zero exit, so what came back has to be checked against what
        // was asked for. A named member is the sharper case: the
        // enclosing class is written out whether or not the member was
        // found, so an item naming one that does not exist yields a
        // class shell with nothing in it, which a check for the class
        // alone would accept.
        _contains_item(raw_path: string, item: string) -> bool static is
            let wants_member = item.contains("::");

            for line in File.read_all_lines(raw_path) do
                let trimmed = line.trim();

                if wants_member then
                    if
                        trimmed.starts_with(".method") \/
                        trimmed.starts_with(".field") \/
                        trimmed.starts_with(".property") \/
                        trimmed.starts_with(".event")
                    then
                        return true;
                    fi
                elif trimmed.starts_with(".class") then
                    return true;
                fi
            od

            return false;
        si

        // A test naming an item in `il.item` has its snapshot scoped to
        // that type or member. Without one the whole assembly is dumped,
        // which is what a test asserting assembly-level shape wants.
        _requested_il_item() -> string? is
            let path = get_path("il.item");

            if !File.exists(path) then
                return null;
            fi

            return File.read_all_text(path).trim();
        si

        // A file whose namespace is compiler-generated takes its name
        // from the source path, so the disassembly of a test with no
        // namespace of its own carries the absolute path it was built
        // at. `normalize_paths` deals with that; this deals with the
        // lines ildasm writes that describe the run rather than the
        // assembly.
        _write_stable_il(raw_path: string, il_out_path: string) static is
            let kept = LIST[string]();

            // The banner is followed by blank lines, which would
            // otherwise open every snapshot with whitespace that means
            // nothing.
            let seen_content mut = false;

            for line in File.read_all_lines(raw_path) do
                if DISASSEMBLER.is_unstable_line(line) then
                    continue;
                fi

                if !seen_content /\ string.is_null_or_white_space(line) then
                    continue;
                fi

                seen_content = true;

                kept.add(line);
            od

            File.write_all_lines(il_out_path, kept);
        si
       
        run_grep(pattern: string, in_file: string, out_file: string) -> bool is
            return
                run(
                    "grep",
                    ["-F", pattern, in_file],
                    5000,
                    out_file,
                    null,
                    _collate_environment
                ) != 0;
        si

        run_sort(in_file: string, out_file: string) -> bool is
            return
                run(
                    "sort",
                    [in_file],
                    5000,
                    out_file,
                    null,
                    _collate_environment
                ) != 0;
        si

        normalize_paths(file_name: string) is
            let path = get_path(file_name);

            if !File.exists(path) then
                return;
            fi

            let test_directory = IO.Path.get_full_path(_test.path);

            if string.is_null_or_empty(test_directory) then
                return;
            fi

            let prefix =
                if test_directory.ends_with('/') \/ test_directory.ends_with('\\') then
                    test_directory;
                else
                    "{test_directory}/";
                fi;

            let content = File.read_all_text(path);

            File.write_all_text(path, content.replace(prefix, ""));
        si

        strip_stack_trace_locations(file_name: string) is
            let path = get_path(file_name);

            if !File.exists(path) then
                return;
            fi

            let content = File.read_all_text(path);

            // Strip the ` in <path>:line <N>` suffix from each `   at …`
            // frame so snapshots don't pin absolute paths or line numbers.
            // Frames without an `in …` suffix (typically ones without debug
            // info) are left intact.
            let pattern = Regex("^( {3}at .+) in [^:]*:line [0-9]+\\s*$", RegexOptions.MULTILINE);

            File.write_all_text(path, pattern.replace(content, "$1"));
        si
        
        run_diff(
            description: string,
            expected_file_name: string mut,
            actual_file_name: string,
            out_file_name: string,
            ignore_space_changes: bool
        ) -> bool
        is
            let expected_path = get_path(expected_file_name);
            let actual_path = get_path(actual_file_name);
            let out_path = get_path(out_file_name);

            if
                !File.exists(expected_path)
            then
                expected_file_name = "/dev/null";
            fi

            if
                !File.exists(actual_path)
            then
                return false;
            fi

            let args: string[] mut;

            if ignore_space_changes then
                args = ["-b", "--strip-trailing-cr", expected_file_name, actual_file_name];
            else
                args = ["--strip-trailing-cr", expected_file_name, actual_file_name];
            fi

            let result = run(
                "diff",
                args,
                5000,
                out_file_name,
                null
            );

            if result != 0 then
                add_fail(description, out_file_name);
            fi
                
            return result == 0;
        si

        run(
            path: string,
            arguments: Iterable[string],
            timeout: int,
            out_file: string?,
            err_file: string?
        ) -> int => 
            run(path, arguments, timeout, out_file, err_file, null);

        run(
            path: string,
            arguments: Iterable[string],
            timeout: int,
            out_file: string?,
            err_file: string?,
            environment: Iterable[Pair[string,string]]?
        ) -> int
        is
            let process = start(path, arguments, environment);
            
            return wait(process, timeout, out_file, err_file);
        si

        start(path: string, arguments: Iterable[string]) -> Process =>
            start(path, arguments, null);

        start(path: string, arguments: Iterable[string], environment: Iterable[Pair[string,string]]?) -> Process is
            let start_info = System.Diagnostics.ProcessStartInfo();

            start_info.file_name = path;

            start_info.use_shell_execute = false;

            if environment? then
                for element in environment do
                    start_info.environment.add(element.key, element.value);
                od                        
            fi

            start_info.arguments =
                arguments |
                    .map(arg =>
                        arg
                            // FIXME: not convinced either of these are necessary
                            .replace("\\", "\\\\")
                            .replace("\"", "\"\""))
                    .to_string(" ");

            start_info.working_directory = _test.path;

            start_info.redirect_standard_output = true;
            start_info.redirect_standard_error = true;
            start_info.use_shell_execute = false;

            let result = Process.start(start_info);

            if !result? then
                throw Exception("failed to start process: {path} {start_info.arguments}");
            fi
            
            return result;
        si

        wait(process: Process, timeout: int, out_file_name: string?, err_file_name: string?) -> int is
            if out_file_name? then
                let stdout = process.standard_output.read_to_end();
                write_all_text(out_file_name, stdout);
            fi
            
            if err_file_name? then
                let stderr = process.standard_error.read_to_end();
                write_all_text(err_file_name, stderr);
            fi
            
            process.wait_for_exit(5000);

            return process.exit_code;
        si

        add_fail(message: string) is
            add_fail(message, null);
        si
        
        add_fail(message: string, file_name: string?) is
            let details: DETAILS mut;

            if file_name? then
                details = DETAILS(message, read_all_text_quiet(file_name));
            else
                details = DETAILS(message);                
            fi

            if !_failure? then
                _failure = FAILURE(_test, details);
            else
                _failure.add(details);
            fi
        si

        mark_if_failed() is
            if _failure? then
                File.create(get_path("failed")).close();
            else
                delete_file("failed");
            fi
        si

        delete_files(file_names: Iterable[string]) is
            for file_name in file_names do
                delete_file(file_name);
            od
        si
        
        delete_file(file_name: string) is
            let file_path = get_path(file_name);

            if File.exists(file_path) then
                File.delete(file_path);
            fi
        si
        
        get_path(file_name: string) -> string =>
            IO.Path.join(_test.path, file_name);

        get_path() -> string =>
            _test.path;

        write_all_text(file_name: string, text: string) is
            File.write_all_text(get_path(file_name), text);
        si
        
        read_all_text(file_name: string) -> string =>
            File.read_all_text(get_path(file_name));

        read_all_text_quiet(file_name: string) -> string is
            let file_path = get_path(file_name);

            if !File.exists(file_path) then
                return "(could not read file: {file_path})";
            fi
            
            return File.read_all_text(get_path(file_name));
        si
    si
si
