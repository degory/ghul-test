namespace Tester is
    use System.Exception;
    use IO.File;
    use IO.Path;
    use IO.Directory;
    use IO.DirectoryInfo;

    use Collections.Iterable;
    use Collections.LIST;

    enum COMPILER_RUN_MODE is
        CI,
        LOCAL,
        DOTNET
    si

    class COMPILER_UNDER_TEST is
        _run_mode: COMPILER_RUN_MODE;
        _publish: string;
        _executable: string;
        _runtime_path: string;
        _sdk_reference_path: string;
        _arguments: Iterable[string];
        _use_dotnet: bool;

        init(run_mode: COMPILER_RUN_MODE) is
            _run_mode = run_mode;

            if _run_mode == COMPILER_RUN_MODE.DOTNET then
                _executable = "dotnet";
                _arguments = ["build"];
            elif _run_mode == COMPILER_RUN_MODE.CI then
                _executable = "dotnet";
                _runtime_path = get_ghul_test_runtime_path();
                _sdk_reference_path = discover_sdk_reference_path();
                _arguments = ["ghul-compiler", "--v3", "--test-run"];
            elif _run_mode == COMPILER_RUN_MODE.LOCAL then
                _publish = find_publish_directory();

                _executable = find_published_compiler();
                _runtime_path = get_published_compiler_path("ghul-runtime.dll");
                _sdk_reference_path = discover_sdk_reference_path();
                _arguments = ["--v3", "--test-run"];
            else
                throw new Exception("unknown run mode: {_run_mode}");
            fi
        si

        runtime_path: string => _runtime_path;

        set_runtime_path(path: string) is
            if string.is_null_or_white_space(path) then
                return;
            fi

            if !File.exists(path) then
                throw new Exception("runtime DLL not found: {path}");
            fi

            _runtime_path = Path.get_full_path(path);
        si
        
        run_compiler(runner: RUNNER, test: TEST) -> bool is
            let arguments = new LIST[string]();

            arguments.add_range(_arguments);

            if test.flags? /\ test.flags.length > 0 then
                arguments.add_range(
                    test.flags.split([' ']) | .map((flag) -> string => flag.trim())
                );
            fi

            let result mut = -1;

            if _run_mode == COMPILER_RUN_MODE.DOTNET then
                result = runner.run(
                    _executable,
                    arguments,
                    5000,
                    "compiler.out", // MSBuild coerces stderr output to stdout
                    null
                );
            else
                arguments.add_range(["--sdk-ref-path", _sdk_reference_path]);
                arguments.add_range(test.source_files);
                arguments.add_range(["-o", "binary.exe"]);

                result = runner.run(
                    _executable,
                    arguments,
                    5000,
                    null,
                    "compiler.out"
                );
            fi

            if !File.exists(runner.get_path("compiler.out")) then
                throw new Exception("compiler output file not found");
            fi

            if result != 0 then
                return false;
            fi

            if _run_mode != COMPILER_RUN_MODE.DOTNET /\ !runner.read_all_text("compiler.out").contains("*** succeeded ***") then
                throw new Exception("compiler success exit status but success message not found in output");
            fi

            // FIXME: this is a bit convoluted:
            return File.exists(get_binary_path(runner));
        si

        get_binary_path_relative_to_test_folder(runner: RUNNER) -> string is
            if _run_mode == COMPILER_RUN_MODE.DOTNET then
                return Path.join(["bin", "Debug", "net8.0", "binary.dll"]);
            fi

            return "binary.exe";
        si

        get_binary_path(runner: RUNNER) -> string is
            if _run_mode == COMPILER_RUN_MODE.DOTNET then
                return Path.join([runner.get_path(), "bin", "Debug", "net8.0", "binary.dll"]);
            fi

            return runner.get_path("binary.exe");
        si

        run_ln_runtime(runner: RUNNER) -> bool is
            if _run_mode == COMPILER_RUN_MODE.DOTNET then
                return true;
            fi

            return runner.run(
                "ln",
                ["-s", _runtime_path, "."],
                1000,
                null,
                null
            ) != 0;
        si

        find_publish_directory() -> string =>
            find_publish_directory(new DirectoryInfo(Directory.get_current_directory()));

        find_publish_directory(from: DirectoryInfo) -> string is
            if !from? then
                throw new Exception("could not find a publish directory");
            fi
            
            let publish = from.get_directories("publish") | .first();

            if publish.has_value then
                return publish.value.full_name;
            fi

            return find_publish_directory(from.parent);
        si

        find_published_compiler() -> string is
            let result mut = get_published_compiler_path("ghul");

            if File.exists(result) then
                return result;
            fi

            result = get_published_compiler_path("ghul.exe");

            if File.exists(result) then
                return result;
            fi

            throw new Exception("Could not find published compiler: {get_published_compiler_path("[ghul|ghul.exe]")}");
        si
        
        get_published_compiler_path(file_name: string) -> string =>
            Path.join(_publish, file_name);

        get_ghul_test_runtime_path() -> string is
            let executing_assembly = System.Reflection.Assembly.get_executing_assembly();

            let assembly_path = Path.get_full_path(executing_assembly.location);

            let result = Path.get_directory_name(assembly_path);

            return Path.join(result, "ghul-runtime.dll");
        si

        // Locate the .NET reference-assembly directory to hand the compiler.
        // The target framework follows what this harness was *built* for, not
        // the runtime it rolls forward onto — the compiler and the test outputs
        // target that framework, so an ecosystem-wide bump needs no change here.
        // The install root comes from `dotnet --list-sdks`, and we take the
        // highest ref pack matching the target framework's version.
        discover_sdk_reference_path() -> string is
            let target_framework = get_target_framework();
            // "net8.0" -> "8.0", to match ref-pack directory names like "8.0.27".
            let framework_version = target_framework.substring(3, target_framework.length - 3);

            let dotnet_root = find_dotnet_root();
            let packs_root = Path.join([dotnet_root, "packs", "Microsoft.NETCore.App.Ref"]);

            if !Directory.exists(packs_root) then
                throw new Exception("no .NET reference assembly packs found at {packs_root}");
            fi

            let pack = find_latest_ref_pack(packs_root, framework_version);

            if !pack? then
                throw new Exception("no Microsoft.NETCore.App.Ref pack matching {framework_version}.* under {packs_root}");
            fi

            let reference_path = Path.join([pack, "ref", target_framework]);

            if !Directory.exists(reference_path) then
                throw new Exception("reference assemblies not found at {reference_path}");
            fi

            return reference_path;
        si

        // The target framework this harness was built for (e.g. "net8.0"),
        // read from the `tfm` field of its runtimeconfig.json. This is the
        // framework the compiler and test outputs target, independent of the
        // runtime we roll forward onto, so an ecosystem-wide bump needs no
        // change here.
        get_target_framework() -> string is
            let assembly = System.Reflection.Assembly.get_executing_assembly();
            let assembly_path = Path.get_full_path(assembly.location);
            let directory = Path.get_directory_name(assembly_path);
            let name = Path.get_file_name_without_extension(assembly_path);
            let config_path = Path.join(directory, "{name}.runtimeconfig.json");

            if !File.exists(config_path) then
                throw new Exception("runtime config not found at {config_path}");
            fi

            let target_framework = extract_json_string(File.read_all_text(config_path), "tfm");

            if !target_framework? then
                throw new Exception("no \"tfm\" entry found in {config_path}");
            fi

            return target_framework;
        si

        // Minimal extractor for a string-valued key in flat JSON; enough for
        // the fixed shape of runtimeconfig.json (no nested escaping in `tfm`).
        extract_json_string(content: string, key: string) -> string? is
            let key_index = content.index_of("\"{key}\"");

            if key_index < 0 then
                return null;
            fi

            let colon = content.index_of(':', key_index);
            let open = if colon >= 0 then content.index_of('"', colon) else -1 fi;
            let close = if open >= 0 then content.index_of('"', open + 1) else -1 fi;

            if close < 0 then
                return null;
            fi

            return content.substring(open + 1, close - open - 1);
        si

        find_dotnet_root() -> string is
            let output = run_and_capture("dotnet", ["--list-sdks"]);

            for line in output.split(['\n']) do
                let trimmed = line.trim();
                let open = trimmed.index_of('[');
                let close = trimmed.last_index_of(']');

                if open >= 0 /\ close > open then
                    // `dotnet --list-sdks` prints `<version> [<root>/sdk]`.
                    let sdk_directory = trimmed.substring(open + 1, close - open - 1).trim();
                    let root = Path.get_directory_name(sdk_directory);

                    if root? /\ Directory.exists(root) then
                        return root;
                    fi
                fi
            od

            throw new Exception("could not determine the .NET install root from `dotnet --list-sdks`");
        si

        find_latest_ref_pack(packs_root: string, framework_version: string) -> string? is
            let best: string? mut = null;
            let best_version: System.Version? mut = null;

            for directory in Directory.get_directories(packs_root, "{framework_version}.*") do
                let version = try_parse_version(Path.get_file_name(directory));

                if version? /\ (!best_version? \/ version.compare_to(best_version) > 0) then
                    best_version = version;
                    best = directory;
                fi
            od

            return best;
        si

        try_parse_version(text: string) -> System.Version? is
            try
                return System.Version.parse(text);
            catch ex: Exception
                return null;
            yrt
        si

        run_and_capture(path: string, arguments: Iterable[string]) -> string is
            let start_info = new System.Diagnostics.ProcessStartInfo();

            start_info.file_name = path;
            start_info.arguments = arguments | .to_string(" ");
            start_info.use_shell_execute = false;
            start_info.redirect_standard_output = true;
            start_info.redirect_standard_error = true;

            let process = System.Diagnostics.Process.start(start_info);

            if !process? then
                throw new Exception("failed to start `{path}`");
            fi

            let output = process.standard_output.read_to_end();

            process.wait_for_exit(5000);

            return output;
        si
    si
si
