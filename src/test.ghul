namespace Tester is
    use Collections.Iterable;

    class TEST(
        path: string,
        source_files: Iterable[string],
        flags: string,
        is_build_fail_expected: bool,
        tags: Iterable[string]
    ) is
        // A library has no entry point, so there is nothing to run and
        // never was: a test that builds one is asserting the shape of
        // what was emitted, not what it does. Running it produces a
        // host error about a missing runtime configuration, which says
        // nothing about the test.
        is_library: bool =>
            flags.split([' ', '\t', '\r', '\n']) | .any(f => f =~ "--library");

        has_executed: bool => result? /\ result.is_executed;
        has_passed: bool => result? /\ result.is_pass;
        has_failed: bool => result? /\ result.is_fail;

        result: Result? public;

        to_string() -> string is
            if let self.result then
                return result.format(path);
            fi

            return "no result: {path}";
        si
    si
si
