#!/bin/bash

# Three lines, each a value, which is everything this program promises.

if [ "$(wc -l < "$1")" != "3" ]; then
    echo "expected three lines, got $(wc -l < "$1")"

    exit 1
fi

if grep -qvE '^value [0-9]+$' "$1"; then
    echo "every line should read 'value <number>':"
    cat "$1"

    exit 1
fi
