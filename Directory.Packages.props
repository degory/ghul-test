    <PackageVersion Include="runtime.linux-x64.Microsoft.NETCore.ILAsm" Version="8.0.0" />
    <PackageVersion Include="runtime.win-x64.Microsoft.NETCore.ILAsm" Version="8.0.0" />
    <PackageVersion Include="runtime.linux-x64.Microsoft.NETCore.ILDAsm" Version="10.0.11" />
    <PackageVersion Include="runtime.win-x64.Microsoft.NETCore.ILDAsm" Version="10.0.11" />

    <!-- unit test dependencies -->
